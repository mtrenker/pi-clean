{
  "version": 1,
  "note": "Repository-owned professional-socials rulebook. Path patterns are deliberately conservative: an unmatched path stays read-only and a hard deny always wins. Live validation on operator-owned accounts is required before any pattern here is treated as DOM-accurate.",
  "match": {
    "pathWildcard": "*",
    "target": "lowercased pathname + search"
  },
